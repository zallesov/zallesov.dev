---
import "@fontsource/black-ops-one";
import "@fontsource-variable/doto/full.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Layout from "../../layouts/Layout.astro";
import Block from "../../components/home/Block.astro";
import ToolboxCubes from "../../components/toolbox/ToolboxCubes";
import HeroSpace from "../../components/hero/HeroSpace";
import ApproachAnimation from "../../components/approach/ApproachAnimation";
import { PIPELINE } from "../../components/approach/pipelineSteps";
import AsciiPortrait from "../../components/portrait/AsciiPortrait";
import cvJson from "../../zall.dev.json";
import { CV } from "../../types/CV";
import { APPROACHES, EXPERTISE, FOCUS, HERO_TAGLINES, HERO_TYPER, LOGOS } from "../../data/home";

const cv = CV.parse(cvJson);

// company logos as inline SVG, so they take the text colour and its hover state
const logoFiles = import.meta.glob<string>("../../assets/logos/*.svg", { query: "?raw", import: "default", eager: true });
const logoSvg = (id: string) => logoFiles[`../../assets/logos/${id}.svg`];
// square marks are drawn taller than wordmarks so both look the same weight
const LOGO_MARKS = new Set(["soundcloud", "zalando", "volkswagen"]);

const NAV = [
  { href: "#approach", label: "Approach" },
  { href: "#career", label: "Career" },
  { href: "#expertise", label: "Expertise" },
  { href: "#toolbox", label: "Toolbox" },
];

// role = short `text` if present, otherwise the first project's title
const career = (cv.employments ?? []).map((e) => ({
  period: `${e.startDate} — ${e.endDate}`,
  company: e.company,
  role: e.text && e.text.length < 40 ? e.text : (e.projects[0]?.title ?? ""),
  about: e.text && e.text.length >= 40 ? e.text : e.projects[0]?.preambule,
  highlights: e.projects.flatMap((p) => p.highlights ?? []),
  stack: e.projects.map((p) => p.stack).filter(Boolean).join(" · "),
  side: false,
}));
const side = (cv.sideProjects ?? []).map((p) => ({
  period: "",
  company: p.name ?? "",
  role: p.title ?? "",
  about: p.preambule,
  highlights: p.highlights ?? [],
  stack: p.stack ?? "",
  side: true,
}));
const edu = cv.educations?.[0];
---

<Layout title="Alex Zall — AI Engineer" canonicalUrl="https://zall.dev/lab/home">
  <div class="min-h-screen bg-[#0d0710] font-body text-white">
    <!-- 00 NAV -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0d0710]/80 backdrop-blur">
      <nav class="mx-auto grid h-14 w-full max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-4 px-4">
        <a href="#top" class="font-dots text-xl leading-none"><span class="text-[#FFDDFF]">Alex</span> <span class="text-[#F97316]">Zall</span></a>
        <ul class="hidden gap-6 font-mono text-xs uppercase tracking-widest text-white/60 sm:flex">
          {NAV.map((n) => <li><a class="transition hover:text-white" href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </header>

    <span id="top"></span>
    <!-- 01 HERO: full-bleed 3D space of spinning cubes on an LED matrix; the role line is written into the lamps -->
    <section id="hero" class="relative isolate flex min-h-[calc((100svh-3.5rem)*0.8)] overflow-hidden border-b border-white/10 bg-[#140a18]">
      <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col justify-end gap-8 px-4 py-10 sm:py-16">
        <h1 class="sr-only">Alex Zall — {HERO_TYPER.final}</h1>
        <!-- typed into the LED matrix at these boxes -->
        <div class="flex flex-col gap-1" aria-hidden="true">
          <div id="hero-lead" class="pointer-events-none w-full"></div>
          <div id="hero-title" class="pointer-events-none w-full"></div>
        </div>
        <!-- drawn into the LED matrix at this box; the plain text stays for search, screen readers and no-WebGL -->
        <div id="hero-role" class="pointer-events-none w-full">
          <p class="hero-role-text max-w-xl text-lg text-white/80 sm:text-2xl">{HERO_TAGLINES[0]}</p>
        </div>
        <div class="flex flex-wrap gap-2 font-mono text-xs uppercase tracking-widest sm:gap-3">
          <a class="inline-flex items-center gap-2 whitespace-nowrap rounded-full bg-[#F97316] px-4 py-3 font-bold text-[#1C0E21] transition hover:brightness-110 sm:px-5" href={cv.calendly}><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Book a call</a>
          {cv.telegram && <a class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-white/20 bg-[#140a18]/70 px-4 py-3 text-white/80 backdrop-blur transition hover:border-white/50 sm:px-5" href={cv.telegram}><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 3.5 2.8 10.7c-.9.4-.9 1.6.1 1.9l4.6 1.5 1.8 5.6c.3.9 1.4 1.1 2 .4l2.6-2.6 4.7 3.5c.7.5 1.7.1 1.9-.7L23 4.9c.2-1-.7-1.8-1.5-1.4Z"/><path d="m7.5 14.1 9.8-6.6-7 7.8"/></svg>Telegram</a>}
          <a class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-white/20 bg-[#140a18]/70 px-4 py-3 text-white/80 backdrop-blur transition hover:border-white/50 sm:px-5" href={cv.pdf}><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h1.5a1.5 1.5 0 0 1 0 3H8v-3zm0 3v2M13 13v5h1a2.5 2.5 0 0 0 0-5h-1z"/></svg>CV</a>
        </div>
      </div>
      <HeroSpace
        client:only="react"
        textColor="#FFDDFF"
        typer={HERO_TYPER}
      />
    </section>

    <main class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6">
      <!-- 02 ABOUT: portrait + expertise -->
      <section id="about" class="grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <AsciiPortrait client:only="react" mode="led" className="md:aspect-auto md:h-full md:min-h-[420px]" />
        <div class="flex flex-col rounded-3xl bg-[#140a18] p-5 ring-1 ring-white/10 sm:p-8">
          <h2 class="font-mono text-xs font-normal uppercase tracking-widest text-white/40"><span aria-hidden="true">[ </span>Expertise<span aria-hidden="true"> ]</span></h2>
          <ul class="mt-4 flex flex-1 flex-col justify-center divide-y divide-white/10">
            {FOCUS.map((f, i) => (
              <!-- number in its own column, so title and line share one exact left edge -->
              <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 gap-y-1 py-3">
                <span class="font-mono text-xs text-[#F97316]">0{i + 1}</span>
                <span class="flex items-center gap-3">
                  <span class:list={["font-dots text-xl leading-tight lg:text-[1.35rem]", f.live ? "text-[#F97316]" : "text-white"]}>{f.title}</span>
                  {f.live && <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#22C55E]" title="right now" />}
                </span>
                <span class="col-start-2 font-mono text-xs leading-snug text-white/50">{f.line}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 03 LOGOS: text wordmarks now, monochrome SVG marquee later -->
      <section aria-label="Companies" class="rounded-3xl bg-[#140a18] px-5 py-6 ring-1 ring-white/10 sm:px-8">
        <ul class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-base font-bold tracking-tight text-white/40 sm:text-lg">
          {LOGOS.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener" aria-label={l.name} class="flex items-center gap-2.5 transition hover:text-white">
                {l.logos.map((id) => (
                  <span class:list={["[&>svg]:block [&>svg]:w-auto", LOGO_MARKS.has(id) ? "[&>svg]:h-[1.6em]" : "[&>svg]:h-[1.15em]"]} set:html={logoSvg(id)} />
                ))}
                {l.kind !== "wordmark" && <span>{l.name}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 04 HOW I WORK -->
      <Block id="approach" label="How I work" bare>
        <div class="flex flex-col gap-6">
          {APPROACHES.map((a, i) => (
            <article id={a.id} class:list={["grid scroll-mt-20 gap-6 rounded-3xl bg-[#140a18] p-5 ring-1 ring-white/10 sm:p-8", !a.steps && "lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)]"]}>
              <div>
                <p class="font-mono text-xs text-[#F97316]">0{i + 1}</p>
                <h3 class="mt-2 font-dots text-3xl leading-tight sm:text-4xl">{a.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-white/70">{a.summary}</p>
                {a.steps ? (
                  <!-- the steps are told by the animation; kept as text for search engines and screen readers -->
                  <ol class="sr-only">
                    {a.steps.map((st) => <li>{st.text}</li>)}
                  </ol>
                ) : (
                <ul class="mt-4 space-y-2 text-[15px] text-white/60">
                  {a.points.map((pt) => <li class="flex gap-2"><span class="text-[#F97316]">→</span><span>{pt}</span></li>)}
                </ul>
                )}
              </div>
              <!-- animated scheme (Remotion, loads on Play); placeholder for the ones not built yet -->
              {a.steps ? (
                <div><ApproachAnimation client:visible id={a.id} label="Play the pipeline" seconds={Math.round(PIPELINE.durationInFrames / PIPELINE.fps)} /></div>
              ) : (
              <div class="flex min-h-[260px] flex-col justify-center gap-5 rounded-2xl border border-dashed border-white/15 p-4 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-widest text-white/30">diagram placeholder</p>
                <ol class="flex flex-wrap items-center gap-2 font-mono text-xs">
                  {a.flow.map((step, k) => (
                    <li class="flex items-center gap-2">
                      <span class="rounded-lg bg-white/5 px-3 py-2 text-white/90 ring-1 ring-white/15">{step}</span>
                      {k < a.flow.length - 1 && <span class="text-white/30">→</span>}
                    </li>
                  ))}
                </ol>
                {a.side && (
                  <ul class="flex flex-wrap gap-2 font-mono text-xs text-white/50">
                    {a.side.map((s) => <li class="rounded-lg border border-dashed border-white/15 px-3 py-2">{s}</li>)}
                  </ul>
                )}
              </div>
              )}
            </article>
          ))}
        </div>
      </Block>

      <!-- 05 CAREER -->
      <Block id="career" label="Career">
        <div class="divide-y divide-white/10 border-y border-white/10">
          {[...career, ...side].map((c) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none flex-wrap items-baseline gap-x-4 gap-y-1 py-4 [&::-webkit-details-marker]:hidden">
                <span class="w-full shrink-0 font-mono text-xs text-white/40 sm:w-44">
                  {c.side ? <span class="rounded bg-white/10 px-1.5 py-0.5 uppercase tracking-widest">side</span> : c.period}
                </span>
                <span class="text-base font-bold sm:text-lg">{c.company}</span>
                <span class="text-[15px] text-white/60">{c.role}</span>
                <span class="ml-auto font-mono text-white/40 transition group-open:rotate-45">+</span>
              </summary>
              <div class="pb-6 sm:pl-48">
                {c.about && <p class="max-w-3xl text-[15px] leading-relaxed text-white/70">{c.about}</p>}
                {c.highlights.length > 0 && (
                  <ul class="mt-3 max-w-3xl space-y-1.5 text-[15px] text-white/60">
                    {c.highlights.map((h) => <li class="flex gap-2"><span class="text-[#F97316]">→</span><span set:html={h} /></li>)}
                  </ul>
                )}
                {c.stack && <p class="mt-3 font-mono text-xs text-white/40">{c.stack}</p>}
              </div>
            </details>
          ))}
        </div>
        {edu && (
          <p class="mt-4 font-mono text-xs text-white/40">
            {edu.startYear} — {edu.endYear} · {edu.university} · {edu.specialisation}
          </p>
        )}
      </Block>

      <!-- 06 EXPERTISE -->
      <Block id="expertise" label="Expertise" bare>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {EXPERTISE.map((e) => (
            <article class="rounded-3xl bg-[#140a18] p-5 ring-1 ring-white/10 sm:p-6">
              <h3 class="font-mono text-xs uppercase tracking-widest text-[#F97316]">{e.title}</h3>
              <p class="mt-3 font-dots text-2xl leading-tight">{e.motto}</p>
              <ul class="mt-4 space-y-1.5 text-[15px] text-white/60">
                {e.items.map((it) => <li>{it}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </Block>

      <!-- 07 TOOLBOX -->
      <section id="toolbox" class="scroll-mt-20">
        <ToolboxCubes client:only="react" />
      </section>

      <!-- 08 WRITING -->
      <Block id="writing" label="Writing" bare>
        <div class="grid gap-4 md:grid-cols-3">
          {(cv.articles ?? []).map((a) => (
            <a href={a.url} class="group rounded-3xl bg-[#140a18] p-5 ring-1 ring-white/10 transition hover:ring-white/30 sm:p-6">
              <h3 class="font-dots text-2xl leading-tight">{a.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-white/60">{a.description}</p>
              <p class="mt-4 font-mono text-xs uppercase tracking-widest text-white/40 transition group-hover:text-[#F97316]">Read on Medium →</p>
            </a>
          ))}
        </div>
      </Block>

      <!-- 09 CONTACT -->
      <section id="contact" class="scroll-mt-20 rounded-3xl bg-[#F97316] p-5 text-[#1C0E21] sm:p-10">
        <p class="font-mono text-xs uppercase tracking-widest opacity-60">[ contact ]</p>
        <h2 class="mt-4 max-w-4xl font-display text-3xl font-bold sm:text-6xl">Let's build your agent team.</h2>
        <div class="mt-8 flex flex-wrap gap-3 font-mono text-xs uppercase tracking-widest">
          <a class="rounded-full bg-[#1C0E21] px-5 py-3 font-bold text-white transition hover:opacity-90" href={cv.calendly}>Book a call →</a>
          <a class="rounded-full border border-[#1C0E21]/40 px-5 py-3 transition hover:border-[#1C0E21]" href={cv.chatLink}>Chat with my agent</a>
          <a class="rounded-full border border-[#1C0E21]/40 px-5 py-3 transition hover:border-[#1C0E21]" href={cv.linkedin}>LinkedIn</a>
          <a class="rounded-full border border-[#1C0E21]/40 px-5 py-3 transition hover:border-[#1C0E21]" href={cv.github}>GitHub</a>
          <a class="rounded-full border border-[#1C0E21]/40 px-5 py-3 transition hover:border-[#1C0E21]" href={cv.pdf}>CV · PDF</a>
        </div>
      </section>
    </main>

    <footer class="mx-auto w-full max-w-6xl px-4 pb-8 pt-2 font-mono text-xs text-white/40">
      {cv.footerNote}
    </footer>
  </div>
</Layout>

<style is:global>

  html {
    scroll-behavior: smooth;
  }
  body {
    background: #0d0710;
  }
  /* the display face has a single weight: never fake a bold */
  /* secondary headings: Doto, fine round dots */
  .font-dots {
    font-weight: 300;
    font-variation-settings: "ROND" 100;
  }
  .font-display {
    font-synthesis: none;
  }
  [data-led-text="on"] .hero-role-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
