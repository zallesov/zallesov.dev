---
// Shelved hero idea: the name as physics letter cubes buried in falling cubes.
import "@fontsource/black-ops-one";
import Layout from "../../layouts/Layout.astro";
import HeroCubes from "../../components/hero/HeroCubes";
---

<Layout title="Hero drop — lab" canonicalUrl="https://zall.dev/lab/hero-drop">
  <main class="mx-auto w-full max-w-6xl px-4 py-6">
    <section class="relative min-h-[78svh] overflow-hidden rounded-3xl bg-[#140a18] ring-1 ring-white/10">
      <h1 class="sr-only">Alex Zall</h1>
      <HeroCubes client:only="react" />
    </section>
  </main>
</Layout>

<style is:global>
  body {
    background: #0d0710;
  }
</style>
