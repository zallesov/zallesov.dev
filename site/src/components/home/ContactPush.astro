---
// Orange contact plate with a "Don't push" button in the middle. Every push bumps a global
// counter (Firestore doc counters/dont-push, the rules only allow +1), shown above the button,
// throws sparks, drops one LED cube into the background (src/components/led/ledCubeRain.ts)
// and reveals the contact buttons.
interface Props {
  calendly?: string;
  linkedin?: string;
  telegram?: string;
  github?: string;
  pdf?: string;
}
const { calendly, linkedin, telegram, github, pdf } = Astro.props;
// line icons (24×24, stroke), same style as the hero buttons
const ICONS = {
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  telegram:
    '<path d="M21.5 3.5 2.8 10.7c-.9.4-.9 1.6.1 1.9l4.6 1.5 1.8 5.6c.3.9 1.4 1.1 2 .4l2.6-2.6 4.7 3.5c.7.5 1.7.1 1.9-.7L23 4.9c.2-1-.7-1.8-1.5-1.4Z"/><path d="m7.5 14.1 9.8-6.6-7 7.8"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  pdf: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h1.5a1.5 1.5 0 0 1 0 3H8v-3zm0 3v2M13 13v5h1a2.5 2.5 0 0 0 0-5h-1z"/>',
};
const links = [
  { href: calendly, label: "Book a call →", primary: true },
  { href: linkedin, label: "LinkedIn", icon: ICONS.linkedin },
  { href: telegram, label: "Telegram", icon: ICONS.telegram },
  { href: github, label: "GitHub", icon: ICONS.github },
  { href: pdf, label: "CV · PDF", icon: ICONS.pdf },
].filter((l) => l.href);
---

<section
  id="contact"
  data-push-root
  class="relative flex min-h-[24rem] scroll-mt-20 flex-col overflow-hidden rounded-3xl bg-[#F97316] p-5 text-[#1C0E21] sm:min-h-[30rem] sm:p-10"
>
  <canvas data-push-cubes class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <canvas data-push-sparks class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

  <h2 class="relative font-mono text-xs font-normal uppercase tracking-widest opacity-60"><span aria-hidden="true">[ </span>Contact<span aria-hidden="true"> ]</span></h2>

  <div class="relative flex flex-1 flex-col items-center justify-center gap-6 py-10 font-mono text-xs uppercase tracking-widest">
    <p data-push-count class="font-dots text-xl font-bold normal-case tracking-normal opacity-0 transition-opacity sm:text-3xl" aria-live="polite"
      style="font-weight: 900; -webkit-text-stroke: 0.035em currentColor">
      Not pushed <span data-push-n>0</span> times
    </p>
    <button
      type="button"
      data-push-button
      class="group relative overflow-hidden rounded-full border-2 border-[#1C0E21] bg-[#F97316] px-7 py-4 text-sm font-bold uppercase transition hover:bg-[#1C0E21] hover:text-white active:scale-95"
    >
      <canvas data-push-glitter class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <span class="relative">Don't push</span>
    </button>
    <div class="flex flex-wrap justify-center gap-3">
      {links.map((l) => (
        <a
          data-push-link
          href={l.href}
          class:list={[
            "invisible inline-flex items-center gap-2 rounded-full px-5 py-3 transition",
            l.primary
              ? "bg-[#1C0E21] font-bold text-white hover:opacity-90"
              : "border border-[#1C0E21]/40 bg-[#F97316] hover:border-[#1C0E21]",
          ]}
        >
          {l.icon && (
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
          )}
          {l.label}
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { cubeRain } from "../led/ledCubeRain";

  const DOC =
    "https://firestore.googleapis.com/v1/projects/zallesov-dev/databases/(default)/documents/counters/dont-push";
  const COMMIT =
    "https://firestore.googleapis.com/v1/projects/zallesov-dev/databases/(default)/documents:commit";

  const root = document.querySelector<HTMLElement>("[data-push-root]");
  if (root) {
    const button = root.querySelector<HTMLButtonElement>("[data-push-button]")!;
    const links = root.querySelectorAll<HTMLElement>("[data-push-link]");
    const sparks = root.querySelector<HTMLCanvasElement>("[data-push-sparks]")!;
    const glitter = root.querySelector<HTMLCanvasElement>("[data-push-glitter]")!;
    const cubes = cubeRain(root.querySelector<HTMLCanvasElement>("[data-push-cubes]")!, root);
    const count = root.querySelector<HTMLElement>("[data-push-count]")!;
    const num = root.querySelector<HTMLElement>("[data-push-n]")!;
    let n = 0;
    const show = (v: number) => {
      n = v;
      num.textContent = v.toLocaleString("en-US").replace(/,/g, " ");
      count.lastChild!.textContent = v === 1 ? " time" : " times";
      count.classList.remove("opacity-0");
    };
    fetch(DOC)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => show(Number(d?.fields?.count?.integerValue ?? 0)))
      .catch(() => {});
    let hot = false;
    button.addEventListener("pointerenter", () => (hot = true));
    button.addEventListener("pointerleave", () => (hot = false));
    sparkle(glitter, () => hot);

    button.addEventListener("click", () => {
      // the links keep their space while invisible, so the button does not jump when they appear
      if (links[0]?.classList.contains("invisible")) popOut(links, button);
      burst(sparks, button);
      show(n + 1);
      cubes?.drop();
      fetch(COMMIT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          writes: [
            {
              transform: {
                document: "projects/zallesov-dev/databases/(default)/documents/counters/dont-push",
                fieldTransforms: [{ fieldPath: "count", increment: { integerValue: "1" } }],
              },
            },
          ],
        }),
      })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          // the server's count, so pushes from other visitors show up too
          const v = d?.writeResults?.[0]?.transformResults?.[0]?.integerValue;
          if (v && Number(v) > n) show(Number(v));
        })
        .catch(() => {});
    });
  }

  // first reveal: each link flies out of the button and lands with a springy overshoot, one by one
  function popOut(links: NodeListOf<HTMLElement>, from: HTMLElement) {
    const b = from.getBoundingClientRect();
    links.forEach((l, i) => {
      l.classList.remove("invisible");
      if (reduced()) return;
      const r = l.getBoundingClientRect();
      const dx = b.left + b.width / 2 - (r.left + r.width / 2);
      const dy = b.top + b.height / 2 - (r.top + r.height / 2);
      l.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(0.2) rotate(${(Math.random() - 0.5) * 40}deg)`, opacity: 0 },
          { transform: "translate(0, -10px) scale(1.12) rotate(0deg)", opacity: 1, offset: 0.6 },
          { transform: "translate(0, 3px) scale(0.96)", offset: 0.8 },
          { transform: "none", opacity: 1 },
        ],
        { duration: 650, delay: 60 + i * 80, easing: "cubic-bezier(.2,.7,.3,1)", fill: "backwards" },
      );
    });
  }

  function reduced() {
    return matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  // ---- sparks -----------------------------------------------------------------------------

  // glitter living inside the button: a few twinkling dots, more of them and brighter on hover
  function sparkle(canvas: HTMLCanvasElement, isHot: () => boolean) {
    if (reduced()) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const dots: { x: number; y: number; vy: number; life: number; max: number; s: number }[] = [];
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
    const tick = () => {
      requestAnimationFrame(tick);
      if (!visible) return;
      const w = (canvas.width = canvas.clientWidth * dpr);
      const h = (canvas.height = canvas.clientHeight * dpr);
      const hot = isHot();
      if (Math.random() < (hot ? 0.9 : 0.25))
        dots.push({ x: Math.random() * w, y: Math.random() * h, vy: -(0.1 + Math.random() * 0.4) * dpr, life: 0, max: 30 + Math.random() * 40, s: (0.8 + Math.random() * 1.4) * dpr });
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = hot ? "#FFDDFF" : "#1C0E21";
      for (let i = dots.length - 1; i >= 0; i--) {
        const d = dots[i];
        d.life++;
        d.y += d.vy;
        if (d.life > d.max) {
          dots.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = Math.sin((d.life / d.max) * Math.PI) * (hot ? 1 : 0.55);
        ctx.fillRect(d.x - d.s / 2, d.y - d.s * 2, d.s, d.s * 4); // little cross-shaped twinkle
        ctx.fillRect(d.x - d.s * 2, d.y - d.s / 2, d.s * 4, d.s);
      }
      ctx.globalAlpha = 1;
    };
    requestAnimationFrame(tick);
  }

  // short shower of sparks flying out of the button on push
  function burst(canvas: HTMLCanvasElement, from: HTMLElement) {
    if (reduced()) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const w = (canvas.width = canvas.clientWidth * dpr);
    const h = (canvas.height = canvas.clientHeight * dpr);
    const c = canvas.getBoundingClientRect();
    const b = from.getBoundingClientRect();
    const cx = (b.left + b.width / 2 - c.left) * dpr;
    const cy = (b.top + b.height / 2 - c.top) * dpr;
    const sparks = Array.from({ length: 70 }, () => {
      const a = Math.random() * Math.PI * 2;
      const v = (3 + Math.random() * 9) * dpr;
      return {
        x: cx + Math.cos(a) * b.width * 0.4 * dpr,
        y: cy + Math.sin(a) * b.height * 0.4 * dpr,
        vx: Math.cos(a) * v,
        vy: Math.sin(a) * v - 2 * dpr,
        life: 0,
        max: 25 + Math.random() * 25,
        c: Math.random() < 0.55 ? "#FFFFFF" : "#1C0E21",
      };
    });
    const tick = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = "round";
      let alive = false;
      for (const p of sparks) {
        if (p.life++ > p.max) continue;
        alive = true;
        const px = p.x;
        const py = p.y;
        p.vx *= 0.92;
        p.vy = p.vy * 0.92 + 0.35 * dpr;
        p.x += p.vx;
        p.y += p.vy;
        ctx.globalAlpha = 1 - p.life / p.max;
        ctx.strokeStyle = p.c;
        ctx.lineWidth = 2 * dpr;
        ctx.beginPath();
        ctx.moveTo(px - p.vx * 1.5, py - p.vy * 1.5); // a short streak behind each spark
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      if (alive) requestAnimationFrame(tick);
      else ctx.clearRect(0, 0, w, h);
    };
    requestAnimationFrame(tick);
  }
</script>
